{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nothing X",
  "version": "3.10.3",
  "identifier": "com.roshan.nothingxdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nothing X",
        "width": 1080,
        "height": 720,
        "minWidth": 400,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

